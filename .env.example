# PodConnect Hub AI - Environment Variables Template
# Duplicate this file to .env and configure secrets.

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# AI ENGINES (GEMINI 2.5 FLASH)
# ==========================================
# Google AI Studio API Key with Search Grounding support
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Self-referential URL or custom domain
APP_URL=http://localhost:3000

# ==========================================
# FIREBASE & GOOGLE WORKSPACE
# ==========================================
# Client-side configuration (overrides firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Set only if using a custom named Firestore database instead of '(default)'
VITE_FIREBASE_DATABASE_ID=

# ==========================================
# AGENT MCP & EXTERNAL ROUTING (OPTIONAL)
# ==========================================
# Secret key for agent session and MCP endpoint access
AGENT_SECRET_KEY=
# Set only if frontend is hosted separately from Express backend
VITE_API_URL=

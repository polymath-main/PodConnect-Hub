# PodConnect Hub AI - Environment Variables Template
# Copy this file to .env and configure your secrets.

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ==========================================
# DATABASE SECRETS & STORAGE (SQLITE / RELATIONAL)
# ==========================================
# File path for persistent SQLite database (default: ./podconnect_leads.db)
DATABASE_PATH=./podconnect_leads.db

# Master secret key for session signing, token verification, and database security
DATABASE_SECRET_KEY=your_database_secret_key_here

# ==========================================
# AI ENGINES (GEMINI 2.5 FLASH)
# ==========================================
# Google AI Studio API Key with Search Grounding support
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# CLOUD FIRESTORE & FIREBASE CONFIGURATION
# ==========================================
# Client-side configuration (loaded from firebase-applet-config.json or overridden here)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0660182225.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0660182225
VITE_FIREBASE_DATABASE_ID=ai-studio-podconnecthubai-7d333a90-2680-4b44-b986-0aad5551056d
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0660182225.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=795913807202
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
